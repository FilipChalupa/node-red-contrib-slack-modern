{
	"name": "node-red-contrib-slack-modern",
	"version": "0.2.2",
	"description": "Slack nodes for Node-RED built for modern Slack apps (Socket Mode + Web API)",
	"scripts": {
		"build": "tsc",
		"prepare": "npm run build",
		"dev": "tsc --watch",
		"start": "npm run dev",
		"test": "npm run build && node --test --test-timeout=10000 test/*.test.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/FilipChalupa/node-red-contrib-slack-modern.git"
	},
	"keywords": [
		"node-red",
		"slack",
		"socket-mode",
		"events-api",
		"typescript"
	],
	"author": "Filip Chalupa",
	"license": "ISC",
	"files": [
		"nodes",
		"examples"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"node-red": {
		"version": ">=4.0.0",
		"nodes": {
			"slack-modern": "nodes/slack-modern.js"
		}
	},
	"dependencies": {
		"@slack/socket-mode": "^3.1.0",
		"@slack/web-api": "^8.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/node-red": "^1.3.5",
		"node-red": "^4.1.16",
		"node-red-node-test-helper": "^0.3.6",
		"typescript": "^5.9.3"
	}
}
